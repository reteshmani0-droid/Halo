# The installers are build output: about 600 MB, regenerated by every release, and Vercel will
# not take them. The published site serves them from a GitHub Release instead and names it in
# `downloads.baseUrl` — see PUBLISHING.md. `web/downloads/.gitkeep` is the empty folder itself.
downloads/*
!downloads/.gitkeep

# Nothing here has dependencies, but a stray install should never be committed.
node_modules/

# Vercel's link to its project, and its local build cache.
.vercel

.DS_Store
